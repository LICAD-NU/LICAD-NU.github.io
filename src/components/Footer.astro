---
import {SITE} from '../config/site';
const base=import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="container footer-grid">
    <div><a href={base} class="footer-brand">LICAD<span>.</span></a><p>Laboratory for Intelligent Control & Applied Dynamics</p><p class="muted">{SITE.institution}<br/>{SITE.location}</p></div>
    <div><h3>Explore</h3><a href={base+'research/'}>Research</a><a href={base+'people/'}>People & alumni</a><a href={base+'collaborators/'}>Collaborators</a><a href={base+'publications/'}>Publications</a><a href={base+'projects/'}>Projects</a></div>
    <div><h3>Connect</h3><a href={base+'news/'}>Lab updates</a><a href={base+'contact/'}>Contact</a>{SITE.github && <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>}<p class="muted">Research with rigor. Innovation with purpose.</p></div>
  </div>
  <div class="container footer-bottom"><span>© {new Date().getFullYear()} LICAD · Nazarbayev University</span><span>Built with Astro · KaTeX · CSS</span></div>
</footer>
