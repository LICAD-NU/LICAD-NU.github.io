---
const {person}=Astro.props;
const d=person.data;
const initials=d.name.split(/\s+/).map((w:string)=>w[0]).slice(0,2).join('');
const base=import.meta.env.BASE_URL;
---
<article class="person-card">
  <a href={`${base}people/${person.id}/`} class="person-image" aria-label={`View ${d.name}'s profile`}>
    {d.photo ? <img src={base+d.photo.replace(/^\//,'')} alt={`Portrait of ${d.name}`} loading="lazy" /> : <span class="initials">{initials}</span>}
    <span class="person-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="person-info"><span class="person-role">{d.role}</span><h3><a href={`${base}people/${person.id}/`}>{d.name}</a></h3>{d.affiliation && <p>{d.affiliation}</p>}</div>
</article>
