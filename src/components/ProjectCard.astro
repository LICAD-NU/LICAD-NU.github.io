---
const {project}=Astro.props;
const d=project.data;
const base=import.meta.env.BASE_URL;
---
<a class="project-card" href={`${base}projects/${project.id}/`}><span class="project-tag">{d.eyebrow}</span><div class="project-icon" aria-hidden="true">{d.area.includes('PDE')?'∂':d.area.includes('Learning')?'↗':'◈'}</div><h3>{d.title}</h3><p>{d.summary}</p><span class="project-link">Explore theme <span aria-hidden="true">↗</span></span></a>
