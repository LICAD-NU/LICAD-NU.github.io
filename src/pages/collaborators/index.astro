---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const base=import.meta.env.BASE_URL;
const collaborators=(await getCollection('collaborators')).sort((a,b)=>a.data.order-b.data.order || a.data.name.localeCompare(b.data.name));
---
<BaseLayout title="Collaborators" description="Academic collaborators and partner institutions of the Laboratory for Intelligent Control & Applied Dynamics.">
  <section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">RESEARCH NETWORK</span><h1>Collaborating across <em>disciplines and borders.</em></h1><p>LICAD welcomes joint research in nonlinear dynamics, advanced control, scientific machine learning, and cyber-resilient systems.</p></div></section>
  <section class="section"><div class="container">
    <div class="section-heading"><div><span class="eyebrow">ACADEMIC NETWORK</span><h2>Our collaborators</h2><p>Profiles are added following verification and the collaborators' approval.</p></div></div>
    {collaborators.length ? <div class="collaborators-grid">{collaborators.map(c => <article class="collaborator-card"><div class="collaborator-avatar">{c.data.photo ? <img src={base+c.data.photo.replace(/^\/+/,'')} alt={`Portrait of ${c.data.name}`} loading="lazy"/> : <span>{c.data.name.split(/\s+/).map(n=>n[0]).slice(0,2).join('')}</span>}</div><div class="collaborator-content"><span class="person-role">{c.data.country || 'ACADEMIC COLLABORATOR'}</span><h3>{c.data.name}</h3>{c.data.title && <p class="collab-title">{c.data.title}</p>}<p>{c.data.institution}</p>{c.data.research.length>0 && <div class="tags">{c.data.research.map(r=><span>{r}</span>)}</div>}{c.data.jointProjects.length>0 && <p class="collab-joint"><strong>Collaboration:</strong> {c.data.jointProjects.join(' · ')}</p>}<div class="profile-links">{c.data.website && <a href={c.data.website} target="_blank" rel="noopener noreferrer">Website ↗</a>}{c.data.scholar && <a href={c.data.scholar} target="_blank" rel="noopener noreferrer">Scholar ↗</a>}{c.data.orcid && <a href={c.data.orcid} target="_blank" rel="noopener noreferrer">ORCID ↗</a>}</div></div></article>)}</div> : <div class="placeholder-panel"><span class="placeholder-icon">◎</span><h3>Collaborator directory ready</h3><p>No names have been published without confirmation. Add a Markdown profile in <code>src/content/collaborators/</code> using the included template to display collaborators automatically.</p></div>}
  </div></section>
  <section class="section section-tinted"><div class="container intro-grid"><div><span class="eyebrow">PARTNER WITH LICAD</span><h2>Open to meaningful research collaborations.</h2></div><div><p>We are interested in shared theoretical studies, computational experiments, joint publications, visiting research, and interdisciplinary projects. For enquiries, use the contact page.</p><a class="text-link" href={base+'contact/'}>Contact the laboratory ↗</a></div></div></section>
</BaseLayout>
