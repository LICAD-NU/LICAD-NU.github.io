---
import BaseLayout from '../layouts/BaseLayout.astro';
import {SITE} from '../config/site';
---
<BaseLayout title="Contact"><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">CONNECT</span><h1>Let's build <em>what's next.</em></h1><p>We welcome conversations about interdisciplinary collaborations, joint projects, and mathematical research.</p></div></section><section class="section"><div class="container contact-grid"><div><span class="eyebrow">FIND US</span><h2>Laboratory for Intelligent Control & Applied Dynamics</h2><p>School of Computing & Artificial Intelligence<br/>Nazarbayev University<br/>Astana, Kazakhstan</p><a class="text-link" href="https://nu.edu.kz/" target="_blank" rel="noopener noreferrer">Nazarbayev University ↗</a></div><div class="contact-panel"><span class="eyebrow">GET IN TOUCH</span><h3>Research inquiries</h3>{SITE.email?<a class="contact-email" href={`mailto:${SITE.email}`}>{SITE.email}</a>:<p>Official lab contact email will be added after confirmation.</p>}<div class="line"></div><h3>Academic contact</h3><p>Dr. Ardak Kashkynbayev · Principal Investigator</p><a class="contact-email" href="mailto:ardak.kashkynbayev@nu.edu.kz">ardak.kashkynbayev@nu.edu.kz</a><div class="line"></div><h3>GitHub Organization</h3>{SITE.github?<a href={SITE.github}>{SITE.github}</a>:<p>GitHub organization link coming soon.</p>}</div></div></section></BaseLayout>
