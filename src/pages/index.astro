---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PersonCard from '../components/PersonCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
import {SITE,researchAreas} from '../config/site';
const base=import.meta.env.BASE_URL;
const members=(await getCollection('people')).filter(p=>p.data.status==='current').sort((a,b)=>a.data.order-b.data.order);
const projects=(await getCollection('projects')).filter(p=>p.data.status==='active').sort((a,b)=>(b.data.startDate||'').localeCompare(a.data.startDate||''));
const papers=(await getCollection('publications')).filter(p=>p.data.featured&&!p.data.draft).sort((a,b)=>b.data.year-a.data.year);
---
<BaseLayout>
<section class="hero">
 <div class="hero-ambient" aria-hidden="true"></div>
 <div class="container hero-grid"><div class="hero-content"><div class="hero-kicker"><span class="status-dot"></span> RESEARCH LABORATORY · NAZARBAYEV UNIVERSITY</div><h1>Exploring the science of <em>intelligent</em> and <em>resilient</em> control.</h1><p>We unite mathematical theory, advanced control, and scientific machine learning to understand complex dynamical systems and design reliable decisions in uncertain environments.</p><div class="hero-actions"><a class="btn btn-primary" href={base+'research/'}>Explore our research <span>↗</span></a><a class="btn btn-ghost" href={base+'people/'}>Meet the team <span>→</span></a></div><div class="hero-affiliation"><span class="affil-line"></span>{SITE.institution}<br/>{SITE.location}</div></div><div class="hero-visual"><img src={base+'images/control-field.svg'} alt="Abstract scientific illustration of interconnected trajectories, control signals, and dynamical systems"/><div class="hero-visual-caption"><span>CONTROL · LEARNING · DYNAMICS</span><span>LICAD / RESEARCH</span></div></div></div>
</section>
<section class="section intro-section"><div class="container intro-grid"><div><span class="eyebrow">WHO WE ARE</span><h2>Rigorous foundations.<br/><span class="accent">Real-world ambition.</span></h2></div><div><p class="intro-lead">{SITE.description}</p><p>Our work spans rigorous stability analysis, reinforcement learning for feedback control, neural-operator approximations, secure networked dynamics, and dynamical approaches to information security. We aim to connect fundamental mathematics with computational methods that can be tested, explained, and trusted.</p><a class="text-link" href={base+'research/'}>Learn about our research <span>↗</span></a></div></div></section>
<section class="section section-tinted"><div class="container"><SectionTitle eyebrow="OUR FOCUS" title="Research at the intersection" description="Seven complementary directions, united by mathematical structure and intelligent decision-making."><a class="text-link" href={base+'research/'}>All research areas ↗</a></SectionTitle><div class="area-grid">{researchAreas.map(a=><a class="area-card" href={base+'research/'}><span class="area-number">{a.number} / 07</span><span class="area-icon">{a.icon}</span><h3>{a.title}</h3><p>{a.summary}</p><span class="area-arrow">↗</span></a>)}</div></div></section>
<section class="section"><div class="container"><SectionTitle eyebrow="RESEARCH PROJECTS" title="Ideas in motion" description="Selected active projects from the laboratory research portfolio."><a class="text-link" href={base+'projects/'}>All projects ↗</a></SectionTitle><div class="projects-grid">{projects.map(project=><ProjectCard project={project}/>)}</div></div></section>
<section class="equation-band"><div class="container equation-grid"><div><span class="eyebrow eyebrow-light">MATHEMATICAL FOUNDATIONS</span><h2>From nonlinear dynamics to learning-enabled control.</h2><p>We connect analytical guarantees with computation—stability, robustness, and performance are central to how we frame research questions.</p><a href={base+'research/'} class="btn btn-outline-light">Our methods ↗</a></div><div class="equation-art"><span>RESEARCH NOTE / 001</span><div class="eq-svg"><img src={base+'images/equation.svg'} alt="Controlled dynamical system equation x dot equals f of x plus g of x times u" /></div><div class="eq-rule"></div><small>Nonlinear dynamics · feedback · stability</small></div></div></section>
<section class="section"><div class="container"><SectionTitle eyebrow="THE PEOPLE" title="Meet our researchers" description="An interdisciplinary team of faculty, postdoctoral researchers, and students."><a class="text-link" href={base+'people/'}>Full team & alumni ↗</a></SectionTitle><div class="people-grid">{members.slice(0,4).map(person=><PersonCard person={person}/>)}</div></div></section>
<section class="section section-tinted"><div class="container"><SectionTitle eyebrow="RESEARCH OUTPUT" title="Selected publications" description="Recent publications from the supplied LICAD bibliography; details are subject to bibliographic verification."><a class="text-link" href={base+'publications/'}>Publications & BibTeX ↗</a></SectionTitle>{papers.length>0?<div class="paper-preview">{papers.map(p=><p>{p.data.title}</p>)}</div>:<div class="placeholder-panel"><span class="placeholder-icon">↗</span><h3>Publications collection is ready</h3><p>Add verified papers, DOIs, BibTeX, and author details to the Markdown collection. No publications have been attributed to the lab without confirmation.</p><a class="text-link" href={base+'publications/'}>View publication page →</a></div>}</div></section>
<section class="section"><div class="container intro-grid"><div><span class="eyebrow">OUR RESEARCH NETWORK</span><h2>Collaboration makes ambitious science possible.</h2></div><div><p>We connect mathematical insight with academic partnerships in control, dynamical systems, and intelligent computation. Explore the collaborator directory or contact us about a joint project.</p><a class="text-link" href={base+'collaborators/'}>Our collaborators ↗</a></div></div></section>
<section class="cta"><div class="container cta-flex"><div><span class="eyebrow eyebrow-light">COLLABORATE WITH US</span><h2>Let's advance the next generation of intelligent control.</h2><p>We welcome research conversations and interdisciplinary collaborations.</p></div><a class="btn btn-white" href={base+'contact/'}>Get in touch <span>↗</span></a></div></section>
</BaseLayout>
