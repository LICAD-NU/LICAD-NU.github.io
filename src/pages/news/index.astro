---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const posts=(await getCollection('news')).filter(n=>!n.data.draft).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime());
const base=import.meta.env.BASE_URL;
---
<BaseLayout title="News"><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">LAB NOTES</span><h1>News & <em>events.</em></h1><p>Research milestones, conferences, collaboration updates, and announcements from LICAD.</p></div></section><section class="section"><div class="container narrow">{posts.length?<div class="news-list">{posts.map(n=><a href={`${base}news/${n.id}/`} class="news-item"><time datetime={n.data.date.toISOString()}>{n.data.date.toLocaleDateString('en-US',{year:'numeric',month:'long',day:'numeric'})}</time><h2>{n.data.title}</h2><p>{n.data.summary}</p><span>Read more ↗</span></a>)}</div>:<div class="placeholder-panel"><h2>News collection is ready</h2><p>Events and announcements will appear here when verified. Use the sample template in <code>src/content/news/</code>.</p></div>}</div></section></BaseLayout>
