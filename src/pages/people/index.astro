---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PersonCard from '../../components/PersonCard.astro';
import {getCollection} from 'astro:content';
const people=(await getCollection('people')).sort((a,b)=>a.data.order-b.data.order);
const groups=[['pi','Principal Investigator'],['postdoc','Postdoctoral Researchers'],['phd','Ph.D. Students'],['research','Research Assistants & Students']];
const alumni=people.filter(p=>p.data.status==='former');
---
<BaseLayout title="People"><section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">OUR TEAM</span><h1>The people behind <em>the research.</em></h1><p>Researchers working across dynamical systems, mathematics, intelligent control, and scientific machine learning.</p></div></section><section class="section"><div class="container">{groups.map(([code,label])=>{const persons=people.filter(p=>p.data.group===code && p.data.status==='current');return persons.length>0 && <div class="team-group"><div class="team-group-head"><span class="eyebrow">CURRENT MEMBERS</span><h2>{label}</h2></div><div class="people-grid">{persons.map(p=><PersonCard person={p}/>)}</div></div>})}</div></section><section class="section section-tinted"><div class="container"><div class="section-heading"><div><span class="eyebrow">FORMER MEMBERS</span><h2>Alumni</h2><p>Former members and their next academic chapters, where provided.</p></div></div><div class="people-grid">{alumni.map(p=><PersonCard person={p}/>)}</div></div></section></BaseLayout>
