---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('projects')).map(project=>({params:{slug:project.id},props:{project}}));}
const {project}=Astro.props;
const {Content}=await render(project);
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={project.data.title}><section class="page-hero compact"><div class="container"><a class="back-link" href={base+'projects/'}>← All research themes</a><span class="eyebrow eyebrow-light">{project.data.eyebrow.toUpperCase()}</span><h1>{project.data.title}</h1><p>{project.data.summary}</p></div></section><section class="section"><div class="container narrow prose"><div class="notice">Illustrative research direction; project status, funding, team and outcomes to be confirmed.</div><Content/></div></section></BaseLayout>
