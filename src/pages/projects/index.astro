---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import {getCollection} from 'astro:content';
const projects=await getCollection('projects');
const byStart=(a:any,b:any)=>(b.data.startDate||'').localeCompare(a.data.startDate||'');
const active=projects.filter(p=>p.data.status==='active').sort(byStart);
const finished=projects.filter(p=>p.data.status==='completed').sort(byStart);
const themes=projects.filter(p=>p.data.status==='theme').sort((a,b)=>a.data.order-b.data.order);
---
<BaseLayout title="Projects" description="Funded and collaborative research projects involving LICAD members.">
  <section class="page-hero"><div class="container"><span class="eyebrow eyebrow-light">LICAD · RESEARCH PORTFOLIO</span><h1>Research projects &amp; <em>partnerships.</em></h1><p>Explore funded work spanning control theory, neural networks, healthcare modelling, AI, and inverse problems.</p></div></section>
  <section class="section"><div class="container">
    <div class="project-stats"><div><strong>{active.length}</strong><span>Active projects</span></div><div><strong>{finished.length}</strong><span>Finished projects</span></div><div><strong>{active.length+finished.length}</strong><span>Recorded projects</span></div></div>
    <div class="section-heading"><div><span class="eyebrow">ONGOING</span><h2>Active projects</h2><p>Listed according to the project dates supplied for this website.</p></div></div>
    <div class="projects-grid">{active.map(p=><ProjectCard project={p}/>)}</div>
    <div class="section-heading project-heading-spaced"><div><span class="eyebrow">ARCHIVE</span><h2>Finished projects</h2><p>Previous funded and collaborative research, newest start dates first.</p></div></div>
    <div class="projects-grid">{finished.map(p=><ProjectCard project={p}/>)}</div>
  </div></section>
  {themes.length>0&&<section class="section section-tinted"><div class="container"><div class="section-heading"><div><span class="eyebrow">RESEARCH DIRECTIONS</span><h2>Related research themes</h2><p>Illustrative research directions, shown separately from funded projects.</p></div></div><div class="projects-grid">{themes.map(p=><ProjectCard project={p}/>)}</div></div></section>}
</BaseLayout>
