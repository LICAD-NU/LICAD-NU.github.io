---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('publications')).filter(p=>!p.data.draft).map(paper=>({params:{slug:paper.id},props:{paper}}));}
const {paper}=Astro.props;const {Content}=await render(paper);const d=paper.data;const base=import.meta.env.BASE_URL;
---
<BaseLayout title={d.title}><section class="page-hero compact"><div class="container"><a class="back-link" href={base+'publications/'}>← All publications</a><span class="eyebrow eyebrow-light">{d.type.toUpperCase()} · {d.year}</span><h1>{d.title}</h1><p>{d.authors}</p></div></section><section class="section"><div class="container narrow prose"><p><strong>Venue:</strong> {d.venue}</p>{d.doi&&<p><strong>DOI:</strong> <a href={`https://doi.org/${d.doi}`}>{d.doi}</a></p>}{d.url&&<p><a href={d.url}>Read paper ↗</a></p>}<Content/>{d.bibtex&&<div class="bibtex"><div class="bibtex-head"><h2>BibTeX</h2><button type="button" id="copy-bib" data-bib={d.bibtex}>Copy BibTeX</button></div><pre><code>{d.bibtex}</code></pre></div>}</div></section></BaseLayout>
<script>document.querySelector<HTMLButtonElement>('#copy-bib')?.addEventListener('click',async function(){try{await navigator.clipboard.writeText(this.dataset.bib||'');this.textContent='Copied!';}catch{this.textContent='Select text to copy';}});</script>
